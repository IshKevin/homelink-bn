NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=HomeLink

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homelink

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
BCRYPT_SALT_ROUNDS=10

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=homelink
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HomeLink <no-reply@homelink.local>

# Optional: consumed once by `npm run seed:admin` (also wired into docker-compose.yml's
# seed-admin service) to create/promote the admin account. Leave blank to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
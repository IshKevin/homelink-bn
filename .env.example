NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=HomeLink
# Comma-separated frontend origin(s) allowed to call this API cross-origin.
# In production, an empty value fails closed (no origins allowed) rather
# than falling back to "*" — set this to the real frontend URL(s).
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/homelink

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
BCRYPT_SALT_ROUNDS=10
ENABLE_OTP=false

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=homelink
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HomeLink <no-reply@homelink.local>

# Optional: consumed once by `npm run seed:admin` (also wired into docker-compose.yml's
# seed-admin service) to create/promote the admin account. Leave blank to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# MTN MoMo (momodeveloper.mtn.com) — Collections charges the tenant,
# Disbursements pays the landlord; separate subscriptions/credentials for
# each. Leave all blank to use the mock mobile-money provider instead.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_BASE_URL=
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# EventBridge: a successful tenant payment publishes here, which triggers
# the automated landlord disbursement (see docs/INFRASTRUCTURE.md). Leave
# blank to skip publishing (disbursement then never fires automatically).
EVENTBRIDGE_BUS_NAME=
PAYOUT_EVENTS_QUEUE_URL=

# Optional: consumed once by `npm run seed:demo` (also wired into docker-compose.yml's
# seed-demo service) to create/reset a fixed set of demo accounts, one per role, with
# well-known credentials for frontend/manual testing. Set to "true" to enable.
SEED_DEMO_USERS=

# MTN MoMo Collections (Request to Pay). Get these from the Collections product
# subscription at https://momodeveloper.mtn.com. Leave MOMO_ENABLED unset/false to keep
# using the mocked MTN provider (e.g. in tests) instead of calling the real API.
MOMO_ENABLED=false
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Sandbox only supports EUR; switch to RWF once you move to production credentials.
MOMO_CURRENCY=EUR
# Public HTTPS URL MTN can reach to deliver the payment callback (e.g. an ngrok tunnel
# in dev). Falls back to APP_URL if unset.
MOMO_CALLBACK_BASE_URL=
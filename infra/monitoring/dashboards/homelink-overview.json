{
  "title": "HomeLink Overview (App Usage & Business Activity)",
  "uid": "homelink-overview",
  "tags": ["homelink"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate by Route",
      "description": "Requests per second handled by the API, grouped by route pattern.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (route) (rate(homelink_http_requests_total[5m]))", "legendFormat": "{{route}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Error Rate (4xx / 5xx)",
      "description": "Client and server error responses per second, by status code.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (status_code) (rate(homelink_http_requests_total{status_code=~\"4..|5..\"}[5m]))", "legendFormat": "{{status_code}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Response Time (p95)",
      "description": "95th percentile request latency, by route.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(homelink_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Logins by Outcome",
      "description": "Login attempts per second — success, invalid credentials, deactivated account, or new-device challenge issued.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (outcome) (rate(homelink_logins_total[5m]))", "legendFormat": "{{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "New Registrations by Role",
      "description": "Self-service sign-ups per second (tenant/owner/agent), by role.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (role) (rate(homelink_registrations_total[5m]))", "legendFormat": "{{role}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rent Payments by Outcome",
      "description": "Payment attempts per second (mobile money, cash, bank transfer), by outcome.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (method, outcome) (rate(homelink_payments_total[5m]))", "legendFormat": "{{method}} - {{outcome}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Leases Created",
      "description": "New leases per second, split by whether a brand-new tenant account was registered alongside it.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (new_tenant) (rate(homelink_leases_created_total[5m]))", "legendFormat": "new tenant: {{new_tenant}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Users by Role (current)",
      "description": "How many registered accounts of each role exist right now.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "homelink_users_total", "legendFormat": "{{role}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Properties by Status (current)",
      "description": "Listed properties right now, by availability status.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "homelink_properties_total", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Units by Status (current)",
      "description": "Individual units across all properties right now — available, occupied, maintenance, or inactive.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "homelink_units_total", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Leases by Status (current)",
      "description": "All leases right now, by lifecycle status.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "homelink_leases_total", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Invoices by Status (current)",
      "description": "All rent invoices right now — unpaid, paid, or overdue.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "homelink_invoices_total", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Active Sessions by Device Type",
      "description": "Currently logged-in sessions (unexpired, unrevoked), by device type — desktop, mobile, tablet, etc. No individual user or raw device info is exposed, only aggregate counts.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (device_type) (homelink_active_sessions_total)", "legendFormat": "{{device_type}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 14,
      "type": "piechart",
      "title": "Active Sessions by Browser / OS",
      "description": "Same active sessions, broken down by browser and operating system instead.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (browser, os) (homelink_active_sessions_total)", "legendFormat": "{{browser}} / {{os}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "What People Are Doing (Actions, last 24h)",
      "description": "Every recorded action across the whole system in the last 24 hours, by type — lease created, payment initiated, user registered, etc.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (action) (increase(homelink_audit_actions_total[24h]))", "legendFormat": "{{action}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
